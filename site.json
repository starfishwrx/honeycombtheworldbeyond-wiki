      "refresh_token_env": "GOOGLE_OAUTH_REFRESH_TOKEN"
    }
  },
  "bing": {
    "access_token_env": "BING_WEBMASTER_ACCESS_TOKEN",
    "oauth": {
      "client_id_env": "BING_WEBMASTER_CLIENT_ID",
      "client_secret_env": "BING_WEBMASTER_CLIENT_SECRET",
      "refresh_token_env": "BING_WEBMASTER_REFRESH_TOKEN"
    }
  },
  "github": {
