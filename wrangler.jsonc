{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeycombtheworldbeyond-wiki",
  "main": "worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
